{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--hostname",
    "homelab"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "KUBECONFIG": "/workspaces/homelab/kubeconfig",
    "PATH": "/workspaces/homelab/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "NVIM_CLIPBOARD": "osc52",
    "TZ": "America/Montreal"
  },
  "postCreateCommand": "./.devcontainer/setup",
  "forwardPorts": [
    3010,
    4010,
    5010,
    6010,
    7010,
    8010,
    9010
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers"
      ]
    }
  }
}
