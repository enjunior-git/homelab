#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: decrypt-secret <file>

Decrypt a Kubernetes secret file in place with sops using the key file
from ./age.agekey.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

file_path="$1"
key_file="age.agekey"

if [[ ! -f "$file_path" ]]; then
  printf 'File not found: %s\n' "$file_path" >&2
  exit 1
fi

if [[ ! -f "$key_file" ]]; then
  printf 'Key file not found: %s\n' "$key_file" >&2
  exit 1
fi

SOPS_AGE_KEY_FILE="$key_file" sops --decrypt --in-place "$file_path"
