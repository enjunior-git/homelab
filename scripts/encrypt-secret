#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: encrypt-secret <file>

Encrypt a Kubernetes secret file in place with sops using the public key
from ./age.agekey.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

file_path="$1"
key_file="age.agekey"

if [[ ! -f "$file_path" ]]; then
  printf 'File not found: %s\n' "$file_path" >&2
  exit 1
fi

if [[ ! -f "$key_file" ]]; then
  printf 'Key file not found: %s\n' "$key_file" >&2
  exit 1
fi

age_public="$(grep -E '^# public key: ' "$key_file" | sed 's/^# public key: //')"

if [[ -z "$age_public" ]]; then
  printf 'Could not read public key from %s\n' "$key_file" >&2
  exit 1
fi

sops --age="$age_public" \
  --encrypt --encrypted-regex '^(data|stringData)$' --in-place "$file_path"
